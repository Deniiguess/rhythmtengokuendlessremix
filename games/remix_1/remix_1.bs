script marching_orders_cue_1
		call marching_orders_sub_08a83848
  	call marching_orders_sub_08a8386c
   	switch_random 5
    	case 0
     		call marching_orders_sub_08a8386c
      break
      case 1
     		call marching_orders_2_sub_08a83cc8
      break
      case 2
