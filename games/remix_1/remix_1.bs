	    rest 12
		break
		case 2
			sneaky_spirits_wind_sfx_enabled TRUE
	    sneaky_spirits_set_ghost_height 32
	    sneaky_spirits_show_ghost 0
	    rest 24
	    sneaky_spirits_set_ghost_height 32
	    sneaky_spirits_show_ghost 1
	    rest 24
