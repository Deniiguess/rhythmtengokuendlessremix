.section .script.entry
@ Remix 1 - Script Entry Point

script script_remix_1_entry
    set_tempo 124
    rest 24
    call script_remix_1_prologue
    set_game_fade_in_time 16
    enable_play_inputs
    goto script_remix_1_main

define_gameplay_scene scene_remix_1, script_remix_1_entry



.section .script.prologue
@ Remix 1 - Prologue

script script_remix_1_prologue
    set_game_fade_in_time 8
    load_game remix_1_prologue_engine, 0
    run stop_all_soundplayers
    rest 24
    play_sfx s_jingle_remix_seqData
    rest 24
    rest 24
    run func_08046700, 1
    rest 2
    run func_08046700, 2
    rest 2
    run func_08046700, 3
    rest 2
    run func_08046700, 4
    rest 2
    run func_08046700, 5
    rest 2
    run func_08046700, 6
    rest 6
    rest 6
    rest 24
    rest 24
    rest 12
    play_sfx s_f_scratch_seqData
    rest 6
    run func_08006d80, 0
    rest 18
    set_game_fade_in_time 16
return



.section .script.main
@ Remix 1 - Marking Criteria

struct remix_1_marking_criteria_0
    /* Positive Remark */     .word D_0805cb08
    /* Negative Remark */     .word D_0805caf8
    /* Flags */               .hword CHECK_AVERAGE_MISSES
    /* Pos: Required Hits */  .hword 0x100 @ 80%
    /* Neg: Minimum Hits */   .hword 0x00 @ 50%
    /* Neg: Maximum Misses */ .hword 0x00 @ 30%
endstruct

struct remix_1_marking_criteria_1
    /* Positive Remark */     .word D_0805cb48
    /* Negative Remark */     .word D_0805cb24
    /* Flags */               .hword CHECK_AVERAGE_HITS | CHECK_AVERAGE_MISSES
    /* Pos: Required Hits */  .hword 0x100 @ 70%
    /* Neg: Minimum Hits */   .hword 0x00 @ 40%
    /* Neg: Maximum Misses */ .hword 0x00 @ 60%
endstruct

struct remix_1_marking_criteria_2
    /* Positive Remark */     .word D_0805cb88
    /* Negative Remark */     .word D_0805cb6c
    /* Flags */               .hword CHECK_AVERAGE_HITS | CHECK_AVERAGE_MISSES
    /* Pos: Required Hits */  .hword 0xB3 @ 70%
    /* Neg: Minimum Hits */   .hword 0x4C @ 30%
    /* Neg: Maximum Misses */ .hword 0x80 @ 50%
endstruct

struct remix_1_marking_criteria
    .word remix_1_marking_criteria_0
    .word remix_1_marking_criteria_1
    .word remix_1_marking_criteria_2
    .word END_OF_CRITERIA
endstruct



@ Remix 1 - Main Script

script script_remix_1_main
    set_tempo 119
    set_music_volume 256
    load_karate_man
    start_perfect_campaign
    rest 24
    enable_pause_menu
    rest 24
    rest 24
    rest 24
    set_results_header D_0805cba0
    import_marking_criteria remix_1_marking_criteria
    run gameplay_set_mercy_count, 0
    set_marking_criteria 0
    set_game_fade_in_time 0
    play_music Lesson1_seqData
    karate_man_print_textbox ER_Start
    rest_beats 8
    karate_man_clear_textbox
    set_byte 0x030002AC, 3
    set_byte 0x030002A8, 0
    set_byte 0x030002A4, 0
    call next_music_part
    call karate_man_cue_1

    call change_scene
    call change_scene
    call change_scene
    call change_scene
    call change_scene

    mod_music_pitch 3072, 26976
    mod_tempo 238, 28800
    loop_start
    call change_scene
    loop_end

return

script change_scene
	if_eq INT8, 0x030002A4, 0

	switch_random 13
				case 0
        	if_eq INT8, 0x030002AC, 0
         		goto change_scene
          end_if
          rest 6
          load_bouncy_road
          set_byte 0x030002AC, 0
          rest 6
          call next_music_part
          goto bouncy_road_init
        break
				case 1
					if_eq INT8, 0x030002AC, 1
         		goto change_scene
         	end_if
        	load_clappy_trio
         	set_byte 0x030002AC, 1
         	rest 12
          call next_music_part
        	goto clappy_trio_init
        break
        case 2
        	if_eq INT8, 0x030002AC, 2
         		goto change_scene
         	end_if
        	load_fireworks
         	set_byte 0x030002AC, 2
         	rest 12
          call next_music_part
        	goto fireworks_init
        break
        case 3
        	if_eq INT8, 0x030002AC, 3
         		goto change_scene
         	end_if
       		load_karate_man
         	set_byte 0x030002AC, 3
         	rest 12
          call next_music_part
        	goto karate_man_init
        break
        case 4
        	if_eq INT8, 0x030002AC, 4
         		goto change_scene
         	end_if
       		load_marching_orders
         	set_byte 0x030002AC, 4
         	rest 12
          call next_music_part
        	goto marching_orders_init
        break
        case 5
        	if_eq INT8, 0x030002AC, 5
         		goto change_scene
         	end_if
       		load_polyrhythm_remix
         	set_byte 0x030002AC, 5
         	rest 12
          call next_music_part
        	goto polyrhythm_init
        break
        case 6
        	if_eq INT8, 0x030002AC, 6
         		goto change_scene
         	end_if
       		load_rhythm_tweezers
         	set_byte 0x030002AC, 6
         	rest 12
          call next_music_part
        	goto rhythm_tweezers_init
        break
        case 7
        	if_eq INT8, 0x030002AC, 7
         		goto change_scene
         	end_if
       		load_showtime
         	set_byte 0x030002AC, 7
         	rest 12
          call next_music_part
        	goto showtime_init
        break
        case 8
        	if_eq INT8, 0x030002AC, 8
         		goto change_scene
         	end_if
       		load_sick_beats
         	set_byte 0x030002AC, 8
         	rest 12
          call next_music_part
        	goto sick_beats_init
        break
        case 9
        	if_eq INT8, 0x030002AC, 9
         		goto change_scene
         	end_if
       		load_sneaky_spirits_remix
          set_byte 0x030002AC, 9
         	rest 12
          call next_music_part
        	goto sneaky_spirits_cue
        break
        case 10
        	if_eq INT8, 0x030002AC, 10
         		goto change_scene
         	end_if
      		load_space_dance
        	set_byte 0x030002AC, 10
         	rest 12
          call next_music_part
        	goto space_dance_init
        break
        case 11
        	if_eq INT8, 0x030002AC, 11
         		goto change_scene
         	end_if
      		load_spaceball
        	set_byte 0x030002AC, 11
         	rest 12
          call next_music_part
        	goto spaceball_init
        break
        case 12
        	if_eq INT8, 0x030002AC, 12
         		goto change_scene
         	end_if
        	load_tap_trial
         	set_byte 0x030002AC, 12
         	rest 12
          call next_music_part
        	goto tap_trial_init
        break
        default
        	goto change_scene
        break
  end_switch

  else
  	goto end_game
	end_if

script next_music_part
	add_byte 0x030002A8, 1
	switch INT8, 0x030002A8
		case 1
			play_music L1_pat01_seqData
		break
		case 2
			play_music L1_pat02_seqData
		break
		case 3
			play_music L1_pat03_seqData
		break
		case 4
			play_music L1_pat04_seqData
		break
		case 5
			play_music L1_pat05_seqData
		break
		case 6
			play_music L1_pat07_seqData
		break
		case 7
			play_music L1_pat01_seqData
		break
		case 8
			play_music L1_pat02_seqData
		break
		case 9
			play_music L1_pat03_seqData
		break
		case 10
			play_music L1_pat04_seqData
		break
		case 11
			play_music L1_pat05_seqData
		break
		case 12
			play_music L1_pat07_seqData
		break
		case 13
			play_music L1_pat08_seqData
		break
		case 14
			play_music L1_pat09_seqData
			set_byte 0x030002A8, 0
		break
		default
			play_music Lesson1_seqData
		break
		end_switch
return

script end_game
		rest 12
		call next_music_part
		beat_anim
		rest 24
    beat_anim
		rest 24
	  disable_pause_menu
    disable_play_inputs
    fade_music_out 48
    fade_screen_out 12, BLACK
    beat_anim
		rest 24
    beat_anim
		rest 24
stop

