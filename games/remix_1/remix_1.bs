script bouncy_road_cue_1
	bouncy_road_enable_ball_goal_sfx
	bouncy_road_deploy_ball 12
	rest_beats 8
	bouncy_road_enable_ball_goal_sfx
	bouncy_road_deploy_ball 12
	rest_beats 7
	rest 12
return

